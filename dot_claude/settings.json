{
  "env": {
    "_ZO_DOCTOR": "0",
    "CLAUDE_KITTY_DEBUG": "1"
  },
  "permissions": {
    "allow": [
      "Bash(glab api *)",
      "Bash(glab mr approve *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/daily-todos.sh",
            "asyncRewake": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/shanesaravia/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/kitty-tab-state.sh start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/kitty-tab-state.sh prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/kitty-tab-state.sh post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/kitty-tab-state.sh notify",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/kitty-tab-state.sh stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/kitty-tab-state.sh end",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/kitty-tab-state.sh subagent-stop",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/kitty-tab-state.sh stop-failure",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(glab api *)",
      "Bash(glab mr approve *)"
    ]
  },
  "voiceEnabled": false,
  "preferredNotifChannel": "kitty"
}
